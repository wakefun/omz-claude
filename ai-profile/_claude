#compdef claude
# omz-ai-profile

_claude() {
  setopt local_options extended_glob
  local f base prefix
  local -a settings_names

  for f in ~/.claude/settings.*.json(N); do
    base=${f:t}
    base=${base#settings.}
    settings_names+=("${base%.json}")
  done

  (( $#settings_names )) || return 1

  if [[ ${words[CURRENT-1]} == --settings ]]; then
    prefix='~/.claude/settings.'
  elif (( CURRENT == 2 )); then
    prefix='--settings ~/.claude/settings.'
  else
    return 1
  fi

  compadd -P "$prefix" -S '.json ' -a settings_names
}

_claude "$@"
